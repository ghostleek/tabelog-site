---
import { Image } from 'astro:assets';
import { RATING_DISPLAY, CATEGORIES } from '../lib/taxonomy';
import { totalVisits, type Restaurant } from '../lib/restaurants';

interface Props {
  restaurant: Restaurant;
}
const { restaurant: r } = Astro.props;
const rating = RATING_DISPLAY[r.data.rating];
const visits = totalVisits(r);

const meta = [
  r.data.area,
  r.data.country !== 'Singapore' ? r.data.country : null,
  r.data.price_per_pax ? `~$${r.data.price_per_pax}/pax` : null,
].filter(Boolean);
---

<a
  href={`/restaurant/${r.id}`}
  data-country={r.data.country}
  class="restaurant-card block rounded-xl border border-stone-200 bg-white p-4 transition hover:border-stone-300 hover:shadow-sm"
>
  {
    r.data.cover && (
      <Image src={r.data.cover} alt={r.data.name} width={640} height={360} class="mb-3 h-40 w-full rounded-lg object-cover" />
    )
  }
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold leading-snug">{r.data.name}</h3>
    <span title={rating.label} class="shrink-0 text-lg">{rating.emoji}</span>
  </div>
  {meta.length > 0 && <p class="mt-1 text-sm text-stone-500">{meta.join(' · ')}</p>}
  <p class="mt-2 flex items-center gap-2 text-xs text-stone-500">
    {r.data.categories.map((c) => (
      <span class="rounded-full bg-stone-100 px-2 py-0.5">{CATEGORIES[c].emoji} {CATEGORIES[c].label}</span>
    ))}
    {r.data.is_hawker && <span class="rounded-full bg-amber-50 px-2 py-0.5 text-amber-800">🏪 hawker</span>}
    {visits > 1 && <span class="ml-auto shrink-0">eaten {visits}×</span>}
  </p>
</a>

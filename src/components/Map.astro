---
// Leaflet island. Loads /search/geo.json (also used by proximity search) and
// renders rating-colored circle markers with popups. On touch devices the map
// starts inert (tap to activate) so it doesn't hijack page scrolling.
interface Props {
  height?: string;
  country?: string; // 'all' disables the filter
}
const { height = 'h-[340px] sm:h-[440px]', country = 'Singapore' } = Astro.props;
---

<div id="map-wrap" class="relative">
  <div id="map" data-country={country} class:list={['w-full rounded-xl border border-stone-200 z-0', height]}></div>
  <button
    id="map-unlock"
    class="absolute inset-0 z-[500] hidden w-full cursor-pointer items-end justify-center rounded-xl bg-transparent pb-4"
    aria-label="Activate map"
  >
    <span class="rounded-full bg-stone-900/80 px-4 py-1.5 text-sm font-medium text-white">Tap to explore the map</span>
  </button>
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.markercluster';
  import 'leaflet.markercluster/dist/MarkerCluster.css';
  import 'leaflet.markercluster/dist/MarkerCluster.Default.css';

  type GeoItem = {
    slug: string;
    name: string;
    lat: number;
    lng: number;
    rating: 'highly_recommend' | 'recommend';
    categories: string[];
    area: string | null;
    price: number | null;
    hawker: boolean;
    country: string;
  };

  const mapEl = document.getElementById('map')!;
  const countryFilter = mapEl.dataset.country || 'Singapore';
  const touch = window.matchMedia('(pointer: coarse)').matches;

  const map = L.map('map', {
    scrollWheelZoom: false,
    dragging: !touch, // inert on touch until explicitly activated
    tap: true,
  }).setView([1.3521, 103.8198], 12);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 19,
  }).addTo(map);

  // Touch: show the unlock chip; one tap enables full interaction.
  const unlock = document.getElementById('map-unlock')!;
  if (touch) {
    unlock.classList.remove('hidden');
    unlock.classList.add('flex');
    unlock.addEventListener('click', () => {
      map.dragging.enable();
      map.scrollWheelZoom.enable();
      unlock.remove();
    });
  }

  const cluster = (L as any).markerClusterGroup({ maxClusterRadius: 40 });

  fetch('/search/geo.json')
    .then((r) => r.json())
    .then((items: GeoItem[]) => {
      const shown = countryFilter === 'all' ? items : items.filter((it) => it.country === countryFilter);
      for (const it of shown) {
        const gold = it.rating === 'highly_recommend';
        const marker = L.circleMarker([it.lat, it.lng], {
          radius: gold ? 9 : 7,
          color: gold ? '#b45309' : '#1d4ed8',
          fillColor: gold ? '#f59e0b' : '#3b82f6',
          fillOpacity: 0.85,
          weight: 2,
        });
        marker.bindPopup(
          `<strong><a href="/restaurant/${it.slug}">${it.name}</a></strong><br>` +
            `${gold ? '⭐ Highly recommend' : '👍 Recommend'}${it.hawker ? ' · 🏪 hawker' : ''}<br>` +
            `${it.area ?? ''}${it.price ? ` · ~$${it.price}/pax` : ''}`
        );
        cluster.addLayer(marker);
      }
      map.addLayer(cluster);
    });

  // "Find me" control: pan to device location
  const FindMe = L.Control.extend({
    options: { position: 'topleft' },
    onAdd() {
      const btn = L.DomUtil.create('a', 'leaflet-bar');
      btn.innerHTML = '📍';
      btn.href = '#';
      btn.title = 'Find me';
      btn.style.cssText = 'width:30px;height:30px;line-height:30px;text-align:center;background:#fff;display:block;font-size:16px;';
      L.DomEvent.on(btn, 'click', (e) => {
        L.DomEvent.preventDefault(e);
        navigator.geolocation?.getCurrentPosition((pos) => {
          const here: [number, number] = [pos.coords.latitude, pos.coords.longitude];
          L.circleMarker(here, { radius: 8, color: '#dc2626', fillColor: '#ef4444', fillOpacity: 0.9 })
            .addTo(map)
            .bindPopup('You are here');
          map.setView(here, 15);
        });
      });
      return btn;
    },
  });
  map.addControl(new FindMe());
</script>

---
import Base from '../layouts/Base.astro';
import Map from '../components/Map.astro';
import Spotlight from '../components/Spotlight.astro';
import RestaurantCard from '../components/RestaurantCard.astro';
import { getPublicRestaurants, slugifyArea, lastVisit } from '../lib/restaurants';
import { CATEGORIES, CATEGORY_SLUGS } from '../lib/taxonomy';

const restaurants = await getPublicRestaurants();
const sg = restaurants.filter((r) => r.data.country === 'Singapore');
const abroad = restaurants.length - sg.length;
const countries = [...new Set(restaurants.map((r) => r.data.country))]
  .filter((c) => c !== 'Singapore')
  .sort();
const featured = sg.filter((r) => r.data.rating === 'highly_recommend');
const recent = [...sg]
  .filter((r) => lastVisit(r))
  .sort((a, b) => lastVisit(b)!.getTime() - lastVisit(a)!.getTime())
  .slice(0, 6);
const areas = [...new Set(sg.map((r) => r.data.area).filter((a): a is string => !!a))].sort();
---

<Base title="tabelog by kahhow — food actually worth revisiting">
  <section class="py-5 text-center sm:py-8">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Food actually worth revisiting</h1>
    <p class="mx-auto mt-3 max-w-xl text-stone-600">
      {sg.length} Singapore places personally eaten, paid for, and rated — hawkers first. Plus {abroad} beyond.
    </p>
    <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
      {
        CATEGORY_SLUGS.map((c) => (
          <a href={`/${c}`} class="rounded-full border border-stone-300 bg-white px-4 py-1.5 text-sm font-medium hover:bg-stone-100">
            {CATEGORIES[c].emoji} {CATEGORIES[c].label}
          </a>
        ))
      }
      <a href="/featured" class="rounded-full border border-amber-300 bg-amber-50 px-4 py-1.5 text-sm font-medium hover:bg-amber-100">⭐ Featured</a>
      <select
        id="country-nav"
        aria-label="Filter by country"
        class="rounded-full border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium"
      >
        <option value="/">🇸🇬 Singapore</option>
        {countries.map((c) => <option value={`/country/${slugifyArea(c)}`}>🌏 {c}</option>)}
        <option value="/all">🌍 Everywhere</option>
      </select>
    </div>
  </section>

  <Spotlight />

  <section class="mt-8">
    <h2 class="sr-only">Map</h2>
    <Map country="Singapore" />
  </section>

  <section class="mt-10">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-bold">⭐ Highly recommended</h2>
      <a href="/featured" class="text-sm font-medium text-stone-500 hover:text-stone-700">all {featured.length} →</a>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {featured.slice(0, 6).map((r) => <RestaurantCard restaurant={r} />)}
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold">🕐 Recently visited</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {recent.map((r) => <RestaurantCard restaurant={r} />)}
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold">📍 By area</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        areas.map((a) => (
          <a href={`/area/${slugifyArea(a)}`} class="rounded-full bg-stone-100 px-3 py-1 text-sm hover:bg-stone-200">
            {a}
          </a>
        ))
      }
    </div>
  </section>
</Base>

<script>
  const sel = document.getElementById('country-nav') as HTMLSelectElement;
  sel.addEventListener('change', () => {
    if (sel.value !== '/') window.location.href = sel.value;
  });
</script>
